# Pravesh environment variables
# ---------------------------------------------------------------------------
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets (API keys, webhook signing secrets, tokens) in a VITE_
# variable. Secrets belong to your backend / API gateway, not this client.

# Public, non-secret values used by the client
VITE_PRAVESH_API_BASE_URL=https://api.example.org/onboarding/v1
VITE_PRAVESH_CONFIG_URL=
VITE_PRAVESH_ENV=development

# Server-side only (consumed by your backend, NOT by Vite)
PRAVESH_WEBHOOK_SECRET=
PRAVESH_API_KEY=
PRAVESH_SMTP_PASSWORD=
